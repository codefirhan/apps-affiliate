# Application Core
APP_NAME="TikTok Auto-Pilot Bot"
APP_ENV=local
APP_SECRET_KEY=change-this-to-a-random-secret-in-production
APP_BASE_URL=http://localhost:8000
TIMEZONE=Asia/Jakarta
DRY_RUN=true

# Persistence & Ephemeral Temp Storage
DATABASE_PATH=./data/tiktok_bot.db
TEMP_ROOT=/tmp/tiktok-bot
FFMPEG_BIN=

# AI Providers (LLM + Transcription)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=

# TTS & Stock Media
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PEXELS_API_KEY=
YOUTUBE_API_KEY=

# Cloudflare R2 (Video Storage) & Cloudflare Images (Thumbnails/Assets)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_AUTO_DELETE_AFTER_PUBLISH=true
CF_IMAGES_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
CF_IMAGES_ACCOUNT_HASH=

# TikTok Official Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://bot.example.com/auth/tiktok/callback

# Telegram Bot (Long Polling)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Worker Intervals (seconds)
WORKER_POLL_SECONDS=15
TEMP_ORPHAN_MAX_AGE_SECONDS=3600
